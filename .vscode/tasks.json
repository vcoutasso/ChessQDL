{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "cmake: build [debug]",
			"type": "shell",
			"command": "make",
			"args": ["debug"],
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"problemMatcher": ["$gcc"],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			}
		},
		{
			"label": "cmake: build [release]",
			"type": "shell",
			"command": "make",
			"args": ["release"],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": ["$gcc"],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			}
		},
		{
			"label": "cmake: run",
			"type": "shell",
			"command": "make",
			"args": ["run"],
			"group": "test",
			"problemMatcher": [],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			}
		},
		{
			"label": "cmake: build and run [release]",
			"type": "shell",
			"command": "./build/bin/ChessQDL",
			"dependsOn": ["cmake: build [release]"],
			"group": "none",
			"problemMatcher": [],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "shared"
			}
		}
	]
}